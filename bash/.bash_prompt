# BASH prompt, sourced by ~/.bashrc
# ==================================

# Two-line prompt: a context line, then `❯` on a line of its own, so that
# every command starts in the same column. A blank line separates the
# prompts in the scrollback. Example (all fields present):
#
#   ~/src/project/lib/module  main ⇡2 +1 !3 ?1  took 14s ✘ 130 INT
#   ❯
#
# Fields, each shown only when it applies:
#   user@host      over SSH (orange) or as root (bold red)
#   path           repository root in bold, its parent directories dimmed
#    branch       ⇡ ahead, ⇣ behind, ✖ conflicts, + staged, ! modified,
#                  ? untracked, ≡ stash entries; then a rebase, merge,
#                  cherry-pick, revert or bisect in progress
#                 virtualenv; its name only if it is not the repository's
#   ✦ n            background or stopped jobs
#   took 14s       duration of the last command, 3 s or more
#   ✘ 130 INT      exit status of a command that ran; signal name above 128;
#                  none for 148 (Ctrl-Z)
#
# Hooks are registered in ~/.bashrc: __prompt_status first (reads `$?`),
# __prompt_build after direnv and history_sync, before kitty's.

# Colours: Tokyo Night (kitty/.config/kitty/tokyonight-night.conf) in
# truecolour, the 16 ANSI colours otherwise, none without colour support
_pc_blue='' _pc_green='' _pc_red='' _pc_yellow='' _pc_purple=''
_pc_cyan='' _pc_orange='' _pc_dim='' _pc_bold='' _pc_reset=''
__prompt_rgb() {
    printf -v "$1" '\\[\\e[38;2;%d;%d;%dm\\]' "0x${2:0:2}" "0x${2:2:2}" "0x${2:4:2}"
}
if [[ ${COLORTERM-} == truecolor || ${COLORTERM-} == 24bit ]]; then
    __prompt_rgb _pc_blue   7aa2f7
    __prompt_rgb _pc_green  9ece6a
    __prompt_rgb _pc_red    f7768e
    __prompt_rgb _pc_yellow e0af68
    __prompt_rgb _pc_purple bb9af7
    __prompt_rgb _pc_cyan   7dcfff
    __prompt_rgb _pc_orange ff9e64
    __prompt_rgb _pc_dim    565f89
elif command -v tput >/dev/null 2>&1 && tput setaf 1 >/dev/null 2>&1; then
    _pc_blue='\[\e[34m\]'   _pc_green='\[\e[32m\]'
    _pc_red='\[\e[31m\]'    _pc_yellow='\[\e[33m\]'
    _pc_purple='\[\e[35m\]' _pc_cyan='\[\e[36m\]'
    _pc_orange='\[\e[33m\]' _pc_dim='\[\e[90m\]'
fi
if [[ -n $_pc_blue ]]; then
    _pc_bold='\[\e[1m\]' _pc_reset='\[\e[0m\]'
fi
unset -f __prompt_rgb

# Escape \, $ and backtick: promptvars expands PS1 again, so a branch
# named `$(cmd)` would run cmd at every prompt
__prompt_esc() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\$/\\\$}
    s=${s//\`/\\\`}
    printf -v "$2" '%s' "$s"
}

# Command start time in µs, set without a fork; unset if no command ran
# shellcheck disable=SC2016  # expanded by bash at each command, not here
PS0='${PS0:$((_prompt_t0=${EPOCHREALTIME/[.,]/}, 0)):0}'

__prompt_status() {
    _prompt_rc=$? _prompt_ms=
    if [[ -n ${_prompt_t0-} ]]; then
        _prompt_ms=$(( (${EPOCHREALTIME/[.,]/} - _prompt_t0) / 1000 ))
        unset _prompt_t0
    else
        # No command ran; `$?` is the previous status, or 130 after Ctrl-C
        _prompt_rc=0
    fi
}

# Two git processes: rev-parse and porcelain v2 status. --no-optional-locks
# avoids index.lock contention with lazygit or tig. Stash count from the
# reflog: `status --show-stash` needs git 2.35 (Ubuntu 22.04 has 2.34).
__prompt_git() {
    _prompt_root='' _prompt_branch='' _prompt_op=''
    _prompt_ahead=0 _prompt_behind=0 _prompt_stash=0
    _prompt_staged=0 _prompt_modified=0 _prompt_untracked=0 _prompt_conflict=0
    local out gitdir commondir line oid head
    local -a stash
    out=$(git rev-parse --show-toplevel --absolute-git-dir --git-common-dir 2>/dev/null) || return 0
    _prompt_root=${out%%$'\n'*} out=${out#*$'\n'}
    gitdir=${out%%$'\n'*} commondir=${out#*$'\n'}
    while IFS= read -r line; do
        case $line in
            '# branch.oid '*)  oid=${line#\# branch.oid } ;;
            '# branch.head '*) _prompt_branch=${line#\# branch.head } ;;
            '# branch.ab '*)   line=${line#\# branch.ab +}
                               _prompt_ahead=${line%% *} _prompt_behind=${line##*-} ;;
            [12]' '*)          [[ ${line:2:1} != . ]] && (( _prompt_staged++ ))
                               [[ ${line:3:1} != . ]] && (( _prompt_modified++ )) ;;
            'u '*)             (( _prompt_conflict++ )) ;;
            '? '*)             (( _prompt_untracked++ )) ;;
        esac
    done < <(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
    if [[ -r $commondir/logs/refs/stash ]]; then
        mapfile -t stash < "$commondir/logs/refs/stash"
        _prompt_stash=${#stash[@]}
    fi
    [[ $_prompt_branch == '(detached)' ]] && _prompt_branch="@${oid:0:7}"
    if [[ -d $gitdir/rebase-merge ]]; then
        _prompt_op="rebase $(<"$gitdir/rebase-merge/msgnum")/$(<"$gitdir/rebase-merge/end")"
        # HEAD is detached during a rebase; show the branch being rebased
        head=$(<"$gitdir/rebase-merge/head-name")
        [[ $head == refs/heads/* ]] && _prompt_branch=${head#refs/heads/}
    elif [[ -d $gitdir/rebase-apply ]];     then _prompt_op=rebase
    elif [[ -f $gitdir/MERGE_HEAD ]];       then _prompt_op=merge
    elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then _prompt_op=cherry-pick
    elif [[ -f $gitdir/REVERT_HEAD ]];      then _prompt_op=revert
    elif [[ -f $gitdir/BISECT_LOG ]];       then _prompt_op=bisect
    fi
    __prompt_esc "$_prompt_branch" _prompt_branch
}

__prompt_build() {
    local p='' head repo sub project jl s

    __prompt_git

    # Blank line before every prompt but the first
    [[ -n ${_prompt_started-} ]] && p+='\n'
    _prompt_started=1

    if (( EUID == 0 )); then
        p+="${_pc_red}${_pc_bold}\u@\h${_pc_reset} "
    elif [[ -n ${SSH_CONNECTION-} ]]; then
        p+="${_pc_orange}\u@\h${_pc_reset} "
    fi

    if [[ -n $_prompt_root && ( $PWD == "$_prompt_root" || $PWD == "$_prompt_root"/* ) ]]; then
        head=${_prompt_root%/*}/
        [[ $head == "$HOME"/* ]] && head="~${head#"$HOME"}"
        __prompt_esc "$head" head
        __prompt_esc "${_prompt_root##*/}" repo
        __prompt_esc "${PWD#"$_prompt_root"}" sub
        p+="${_pc_dim}${head}${_pc_blue}${_pc_bold}${repo}${_pc_reset}"
        p+="${_pc_blue}${sub}${_pc_reset}"
    else
        p+="${_pc_blue}\w${_pc_reset}"
    fi

    if [[ -n $_prompt_branch ]]; then
        p+=" ${_pc_purple}"$'\ue725'" ${_prompt_branch}"
        (( _prompt_ahead ))     && p+=" ${_pc_cyan}⇡${_prompt_ahead}"
        (( _prompt_behind ))    && p+=" ${_pc_cyan}⇣${_prompt_behind}"
        (( _prompt_conflict ))  && p+=" ${_pc_red}✖${_prompt_conflict}"
        (( _prompt_staged ))    && p+=" ${_pc_green}+${_prompt_staged}"
        (( _prompt_modified ))  && p+=" ${_pc_yellow}!${_prompt_modified}"
        (( _prompt_untracked )) && p+=" ${_pc_dim}?${_prompt_untracked}"
        (( _prompt_stash ))     && p+=" ${_pc_dim}≡${_prompt_stash}"
        p+=$_pc_reset
        [[ -n $_prompt_op ]] && p+=" ${_pc_orange}${_pc_bold}${_prompt_op}${_pc_reset}"
    fi

    # Venv name omitted when it repeats the repository name
    if [[ -n ${VIRTUAL_ENV-} ]]; then
        project=${VIRTUAL_ENV%/*}
        project=${project##*/}
        p+=" ${_pc_yellow}"$'\ue73c'
        if [[ -z $_prompt_root || $project != "${_prompt_root##*/}" ]]; then
            __prompt_esc "$project" project
            p+=" $project"
        fi
        p+=$_pc_reset
    fi

    # jobs -p in a command substitution still lists this shell's jobs
    jl=$(jobs -p)
    if [[ -n $jl ]]; then
        jl=${jl//[!$'\n']}
        p+=" ${_pc_cyan}✦ $(( ${#jl} + 1 ))${_pc_reset}"
    fi

    if (( ${_prompt_ms:-0} >= 3000 )); then
        s=$(( _prompt_ms / 1000 ))
        if   (( s >= 3600 )); then s="$(( s / 3600 ))h$(( s % 3600 / 60 ))m"
        elif (( s >= 60 ));   then s="$(( s / 60 ))m$(( s % 60 ))s"
        else                       s="${s}s"
        fi
        p+=" ${_pc_dim}took${_pc_reset} ${_pc_yellow}${s}${_pc_reset}"
    fi

    if (( _prompt_rc && _prompt_rc != 148 )); then
        s=$_prompt_rc
        (( _prompt_rc > 128 && _prompt_rc < 160 )) &&
            s+=" $(kill -l $(( _prompt_rc - 128 )) 2>/dev/null)"
        p+=" ${_pc_red}✘ ${s}${_pc_reset}\n${_pc_red}❯${_pc_reset} "
    else
        p+="\n${_pc_green}❯${_pc_reset} "
    fi

    PS1=$p
}
