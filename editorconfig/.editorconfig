#  ______________
# < EditorConfig >
#  --------------
#  \
#   \
#    \ >()_
#       (__)__ _

# https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing whitespace is significant: Markdown line breaks, diff context lines
[*.{md,diff,patch}]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 4
indent_style = space

[*.py]
indent_size = 4
indent_style = space

# Matches neovim/.config/nvim/.stylua.toml
[*.lua]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab

[*.{mail,email}]
max_line_length = 80

[*.tex]
indent_size = 4
indent_style = space

[*.{json,yml,yaml}]
indent_size = 2
indent_style = space
