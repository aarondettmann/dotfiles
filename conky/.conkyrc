--   ___ ___  _ __ | | ___   _ _ __ ___
--  / __/ _ \| '_ \| |/ / | | | '__/ __|
-- | (_| (_) | | | |   <| |_| | | | (__
--  \___\___/|_| |_|_|\_\\__, |_|  \___|
--                       |___/

conky.config = {

    --------------------------------------------------------------------
    -- Alignment
    --------------------------------------------------------------------
    alignment     = 'top_right',
    gap_x         = 10,
    gap_y         = 50,
    minimum_width = 300,
    maximum_width = 300,

    --------------------------------------------------------------------
    -- General
    --------------------------------------------------------------------
    total_run_times       = 0,
    update_interval       = 1,
    background            = true,
    double_buffer         = true,
    no_buffers            = true,
    text_buffer_size      = 4096,
    format_human_readable = true,
    short_units           = true,

    --------------------------------------------------------------------
    -- Window
    --------------------------------------------------------------------
    own_window             = true,
    own_window_type        = 'dock',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_colour      = '000000',
    own_window_hints       = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    --------------------------------------------------------------------
    -- Drawing
    --------------------------------------------------------------------
    draw_shades          = false,
    draw_outline         = false,
    draw_borders         = false,
    draw_graph_borders   = true,
    default_graph_height = 10,

    --------------------------------------------------------------------
    -- Fonts & Colours
    --------------------------------------------------------------------
    use_xft               = true,
    xftalpha              = 0.1,
    override_utf8_locale  = true,
    uppercase             = false,

    default_color         = 'c5c5c5',
    default_shade_color   = '333333',
    default_outline_color = '000000',

    font = 'Hack:style=Bold:size=9',

    --------------------------------------------------------------------
    -- Sampling
    --------------------------------------------------------------------
    cpu_avg_samples = 4,
    net_avg_samples = 2,
};

conky.text = [[
${alignr}${font Hack:style=Medium:pixelsize=30}${time %H:%M}${font}
${alignr}${font Hack:style=Medium:pixelsize=15}${time %A %e %B %Y}${font}

SYSTEM  ${hr 2}
${voffset -5}
#
Hostname ${alignr}$nodename
Uptime   ${alignr}$uptime_short
Kernel   ${alignr}$kernel
Distro   ${alignr}${execi 86400 sh -c '. /etc/os-release && printf "%s\n" "$PRETTY_NAME"'}

Disk     ${goto 70}${fs_used_perc /}% of ${fs_size /}${alignr}${fs_bar 6,120 /}
Memory   ${goto 70}${memperc}% of ${memmax}${alignr}${membar 6,120}
Swap     ${goto 70}${swapperc}% of ${swapmax}${alignr}${swapbar 6,120}
CPU      ${goto 70}${cpu}%${alignr}${cpubar 6,120}

NETWORK  ${hr 2}
${voffset -5}
#
Interface    ${alignr}$gw_iface
SSID         ${alignr}${wireless_essid $gw_iface}
Local IP     ${alignr}${addrs $gw_iface}
External IP  ${alignr}${execi 1800 curl -4 -fsS https://api.ipify.org || echo n/a}

# Use a monospaced font here so the two columns remain aligned.
Down ${downspeed $gw_iface}/s [${totaldown $gw_iface}]${goto 160}Up ${upspeed $gw_iface}/s [${totalup $gw_iface}]
${downspeedgraph $gw_iface 25,135 5e7b7b d8deeb -t}${goto 160}${upspeedgraph $gw_iface 25,135 99c8e8 618094 -t}

UPDATES  ${hr 2}
${voffset -5}
#
${execi 300 sh -c '
COUNT=$(apt list --upgradable 2>/dev/null | tail -n +2 | wc -l)

if [ "$COUNT" -eq 0 ]; then
    echo "System up to date"
else
    echo "$COUNT package(s) can be upgraded"
fi
'}

]]

-- vim: ts=4 sw=4 noet ai cindent syntax=lua
