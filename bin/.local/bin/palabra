#!/usr/bin/env python3
"""Spanish vocabulary of the day, for status lines, widgets and the shell.

The word list (tab-separated: word, gloss, example sentence; `#` lines and
empty lines ignored) is consumed in file order, one new entry per day from
START_DATE on, wrapping around at the end. Each day shows the new entry and
the entries introduced 1, 2, 4, 7, 15, 30, 60 and 120 days earlier. Nothing
is recorded between runs.

Environment:
  PALABRA_START   Start date (YYYY-MM-DD), default START_DATE below
  PALABRA_WORDS   Word list, default ~/.local/share/palabra/words.tsv
"""

import argparse
import os
import sys
import textwrap
import time
import zlib
from datetime import date
from pathlib import Path

START_DATE = date(2026, 7, 27)
REVIEW_OFFSETS = (1, 2, 4, 7, 15, 30, 60, 120)

# Glyphs of the new entry and of the reviews, taller for older reviews
NEW_GLYPH = "✦"
REVIEW_GLYPHS = dict(zip(REVIEW_OFFSETS, "▁▂▃▄▅▆▇█"))

# Tokyo Night colours of the --tmux line
GLYPH_COLORS = (
    "#7aa2f7",  # blue
    "#7dcfff",  # cyan
    "#9ece6a",  # green
    "#ff007c",  # magenta
    "#ff9e64",  # orange
    "#bb9af7",  # purple
    "#f7768e",  # red
    "#73daca",  # teal
    "#e0af68",  # yellow
)
WORD_COLOR = "#c0caf5"
GLOSS_COLOR = "#a9b1d6"


def read_entries(path):
    """The (word, gloss, sentence) tuples of the word list.

    Raises ValueError with a `file:line: reason` message for a malformed list.
    """
    entries = []
    words = set()
    lines = path.read_text(encoding="utf-8").splitlines()
    for number, line in enumerate(lines, 1):
        if not line or line.startswith("#"):
            continue
        fields = tuple(line.split("\t"))
        if len(fields) != 3:
            raise ValueError(f"{path}:{number}: {len(fields)} fields instead of 3")
        for field in fields:
            if not field:
                raise ValueError(f"{path}:{number}: empty field")
            if field != field.strip():
                raise ValueError(f"{path}:{number}: whitespace around {field!r}")
        if fields[0] in words:
            raise ValueError(f"{path}:{number}: duplicate word {fields[0]!r}")
        words.add(fields[0])
        entries.append(fields)
    if not entries:
        raise ValueError(f"{path}: word list is empty")
    return entries


def todays_indices(day, count):
    """The (index, offset) pairs of the day, the new entry first.

    The new entry has offset 0, and the reviews follow, oldest last. An index
    is listed once, with its smallest offset, even when the reviews wrap onto
    each other.
    """
    offsets = [0, *(offset for offset in REVIEW_OFFSETS if day >= offset)]
    pairs = {}
    for offset in offsets:
        pairs.setdefault((day - offset) % count, offset)
    return list(pairs.items())


def wrap(text, width, indent=""):
    """The text wrapped at width, each line prefixed with indent.

    Without a width the text is returned as one line. A word longer than
    the width is kept whole on its own line.
    """
    if not width:
        return indent + text
    return textwrap.fill(
        text,
        width,
        initial_indent=indent,
        subsequent_indent=" " * len(indent),
        break_long_words=False,
        break_on_hyphens=False,
    )


def table(rows, width):
    """The rows as aligned lines, the new entry under Hoy, reviews under Repaso.

    Only the sentence column is wrapped, so the columns stay aligned.
    """
    widths = [max(len(row[column]) for row in rows) for column in (0, 1)]
    lines = []
    for label, group in (("Hoy", rows[:1]), ("Repaso", rows[1:])):
        if group:
            lines.append(label)
        for word, gloss, sentence in group:
            prefix = f"  {word:{widths[0]}}  {gloss:{widths[1]}}  "
            lines.append(wrap(sentence, width, prefix))
    return lines


def tmux_line(word, gloss, sentence, offset):
    """The `glyph word · gloss · sentence` line with tmux styles.

    The glyph shows the offset, and its colour depends only on the word. The
    line ends in WORD_COLOR, the foreground of the status line, so `#[none]`
    suffices; `#[default]` would restore `status-style`.
    """
    glyph = REVIEW_GLYPHS.get(offset, NEW_GLYPH)
    color = GLYPH_COLORS[zlib.crc32(word.encode()) % len(GLYPH_COLORS)]
    word, gloss, sentence = (
        text.replace("#", "##") for text in (word, gloss, sentence)
    )
    dot = "#[none,dim] · "
    return (
        f"#[fg={color},none]{glyph} "
        f"#[fg={WORD_COLOR},none,bold]{word}{dot}"
        f"#[fg={GLOSS_COLOR},none]{gloss}{dot}"
        f"#[fg={WORD_COLOR},none,italics]{sentence}"
        "#[none]"
    )


def fail(message, to_stdout):
    """Print the message as an error and exit.

    In --line mode it goes to stdout, so that a status line shows it instead
    of nothing (tmux discards stderr).
    """
    print(f"palabra: {message}", file=sys.stdout if to_stdout else sys.stderr)
    sys.exit(1)


def positive_int(text):
    value = int(text)
    if value < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return value


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--line",
        action="store_true",
        help="one `word · gloss · sentence` line, rotating through today's "
        "entries once per minute",
    )
    mode.add_argument(
        "--tmux",
        action="store_true",
        help="like --line, with tmux styles and a glyph for the review age",
    )
    mode.add_argument(
        "--new",
        action="store_true",
        help="the new entry only, with its sentence on a second line",
    )
    parser.add_argument(
        "--date",
        type=date.fromisoformat,
        metavar="YYYY-MM-DD",
        help="show the entries of that day instead of today",
    )
    parser.add_argument(
        "--width",
        type=positive_int,
        metavar="N",
        help="wrap the output at N columns (the sentence column in the table)",
    )
    args = parser.parse_args()
    if args.tmux and args.width:
        parser.error("--width cannot be combined with --tmux")

    try:
        start = date.fromisoformat(os.environ.get("PALABRA_START", str(START_DATE)))
    except ValueError as error:
        fail(f"PALABRA_START: {error}", args.line or args.tmux)
    data_home = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share"
    words_file = (
        os.environ.get("PALABRA_WORDS") or Path(data_home) / "palabra/words.tsv"
    )
    try:
        entries = read_entries(Path(words_file))
    except (OSError, ValueError) as error:
        fail(error, args.line or args.tmux)

    today = args.date or date.today()
    day = max((today - start).days, 0)
    pairs = todays_indices(day, len(entries))
    rows = [entries[index] for index, _ in pairs]

    # The row shown by --line and --tmux changes once a minute
    shown = int(time.time() // 60) % len(rows)
    if args.line:
        word, gloss, sentence = rows[shown]
        lines = [wrap(f"{word} · {gloss} · {sentence}", args.width)]
    elif args.tmux:
        lines = [tmux_line(*rows[shown], pairs[shown][1])]
    elif args.new:
        word, gloss, sentence = rows[0]
        lines = [wrap(f"{word} · {gloss}", args.width), wrap(sentence, args.width)]
    else:
        lines = table(rows, args.width)
    print("\n".join(lines))


if __name__ == "__main__":
    main()
