[user]
    name = Aaron Dettmann
    useConfigOnly = true

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    # delta (package `git-delta`) adds syntax highlighting, line numbers and
    # n/N file navigation. A missing pager is fatal for every paged command,
    # hence the fallback to less.
    pager = "sh -c 'if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi'"

[delta]
    navigate = true
    line-numbers = true
    # Tokyo Night (night) colours for removed and added lines and their line
    # numbers, from folke/tokyonight.nvim extras/delta. delta's default
    # backgrounds (#3f0001, #002800) are barely distinguishable from the
    # kitty background #1a1b26.
    minus-style = syntax "#4a272f"
    minus-non-emph-style = syntax "#4a272f"
    minus-emph-style = syntax "#713137"
    minus-empty-line-marker-style = syntax "#4a272f"
    line-numbers-minus-style = "#914c54"
    plus-style = syntax "#243e4a"
    plus-non-emph-style = syntax "#243e4a"
    plus-emph-style = syntax "#2c5a66"
    plus-empty-line-marker-style = syntax "#243e4a"
    line-numbers-plus-style = "#449dab"
    line-numbers-zero-style = "#3b4261"

[init]
    defaultBranch = main

[alias]
    a = add
    amend = commit --amend
    an = commit --amend --no-edit
    c = commit
    cb = switch -c
    co = switch
    d = diff
    ds = diff --staged
    lg = log --oneline --graph --decorate -n 20
    ll = log -n 1
    # Switch to the remote's default branch (`main` if unknown) and pull.
    # origin/HEAD is set at clone time only, hence the refresh first.
    main = "!git remote set-head origin -a >/dev/null 2>&1; b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main); git switch \"${b#origin/}\" && git pull"
    # Refuses to overwrite commits pushed by someone else since the last fetch
    pf = push --force-with-lease --force-if-includes
    root = rev-parse --show-toplevel
    # --branch adds the ahead/behind header line
    s = status --short --branch
    st = stash
    stp = stash pop
    undo = restore --
    # Works before the first commit; without a path, unstages all
    unstage = reset -q --

[fetch]
    prune = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    followTags = true

[rebase]
    autoStash = true
    updateRefs = true

[commit]
    verbose = true

[log]
    date = iso-local

[grep]
    lineNumber = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[diff]
    algorithm = histogram
    colorMoved = default
    tool = nvim_difftool

# Neovim's builtin difftool (`:help :DiffTool`); `git difftool -d` shows the
# whole diff in one instance
[difftool "nvim_difftool"]
    cmd = nvim -c \"packadd nvim.difftool\" -d \"$LOCAL\" \"$REMOTE\"

[difftool]
    prompt = false

[merge]
    tool = nvimdiff
    conflictstyle = zdiff3

[mergetool]
    prompt = false
    keepBackup = false
    # Show only the conflicts git could not resolve itself
    hideResolved = true

[mergetool "nvimdiff"]
    # Three columns instead of the default four-way layout: zdiff3 conflict
    # markers already include the base, so the BASE window adds nothing.
    layout = LOCAL,MERGED,REMOTE

[rerere]
    enabled = true
    # Stage files rerere resolved, so `rebase --continue` needs no manual add
    autoUpdate = true

[help]
    autocorrect = prompt

[url "https://github.com/"]
    insteadOf = gh:

# Written by `git lfs install`
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# Last, so that machine-local settings override everything above
[include]
    path = ~/.gitconfig.local
