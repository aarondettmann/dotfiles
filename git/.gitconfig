[user]
    name = Aaron Dettmann
    useConfigOnly = true

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    # delta (package `git-delta`) adds syntax highlighting, line numbers and
    # n/N file navigation. A missing pager is fatal for every paged command,
    # hence the fallback to less.
    pager = "sh -c 'if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi'"

[delta]
    navigate = true
    line-numbers = true

[init]
    defaultBranch = main

[alias]
    a = add
    amend = commit --amend
    an = commit --amend --no-edit
    c = commit
    cb = switch -c
    co = switch
    d = diff
    ds = diff --staged
    lg = log --oneline --graph --decorate -n 20
    ll = log -n 1
    # Refuses to overwrite commits pushed by someone else since the last fetch
    pf = push --force-with-lease --force-if-includes
    root = rev-parse --show-toplevel
    # --branch adds the ahead/behind header line
    s = status --short --branch
    st = stash
    stp = stash pop
    undo = restore --
    unstage = restore --staged --

[fetch]
    prune = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    followTags = true

[rebase]
    autoStash = true
    updateRefs = true

[commit]
    verbose = true

[log]
    date = iso-local

[grep]
    lineNumber = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    tool = nvimdiff
    conflictstyle = zdiff3

[mergetool]
    prompt = false
    keepBackup = false
    # Show only the conflicts git could not resolve itself
    hideResolved = true

[mergetool "nvimdiff"]
    # Three columns instead of the default four-way layout: zdiff3 conflict
    # markers already include the base, so the BASE window adds nothing.
    layout = LOCAL,MERGED,REMOTE

[rerere]
    enabled = true
    # Stage files rerere resolved, so `rebase --continue` needs no manual add
    autoUpdate = true

[help]
    autocorrect = prompt

[url "https://github.com/"]
    insteadOf = gh:

# Written by `git lfs install`
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# Last, so that machine-local settings override everything above
[include]
    path = ~/.gitconfig.local
