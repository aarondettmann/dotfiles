# Copy to ~/.gitconfig.local (untracked). Identities go in ~/.gitconfig.work
# and ~/.gitconfig.personal.

[includeIf "gitdir:~/projects/**"]
    path = ~/.gitconfig.work

[includeIf "gitdir:~/projects/_personal/**"]
    path = ~/.gitconfig.personal

# Optional fallback: select the work identity by remote URL (replace
# your-work-org).
# [includeIf "hasconfig:remote.*.url:git@github.com:your-work-org/**"]
#     path = ~/.gitconfig.work
# [includeIf "hasconfig:remote.*.url:https://github.com/your-work-org/**"]
#     path = ~/.gitconfig.work
